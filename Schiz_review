"""**Permutation Test Coverage**"""

def permutation_test_coverage(cam_mask, roi_mask, n_perm=500):
    observed = roi_coverage(cam_mask, roi_mask)

    random_scores = []

    flat_cam = cam_mask.flatten()

    for _ in range(n_perm):
        shuffled = np.random.permutation(flat_cam)
        shuffled_mask = shuffled.reshape(cam_mask.shape)
        random_scores.append(roi_coverage(shuffled_mask, roi_mask))

    random_scores = np.array(random_scores)

    p_value = np.mean(random_scores >= observed)

    return observed, np.mean(random_scores), p_value

